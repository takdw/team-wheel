  "components": [
    {
      "name": "Spin action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Saved-result action; disabled during saving and rotation.",
      "html": "<button class=\"ds-spin\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"m18 14 4 4-4 4M18 2l4 4-4 4M2 18h2c5 0 7-12 12-12h6M2 6h2c2 0 4 2 5 4m6 4c1 2 3 4 5 4h2\"/></svg><span>Spin the wheel</span><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button>",
      "css": ".ds-spin{font-family:\"Manrope Variable\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:11px;min-width:253px;min-height:51px;padding:10px 15px;border:0;border-radius:9px;background:var(--green,#2d5641);color:#faffed;font-size:14px;font-weight:650;cursor:pointer;transition:background .16s,color .16s}.ds-spin svg:last-child{margin-left:20px}.ds-spin:hover:not(:disabled){background:var(--green-hover,#214532)}.ds-spin:focus-visible{outline:3px solid var(--focus,#bb7536);outline-offset:4px}.ds-spin:disabled{background:#bac6b6;color:#354b37;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-spin{transition-duration:.01ms}}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Quiet framed header action.",
      "html": "<button class=\"ds-secondary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><rect x=\"8\" y=\"8\" width=\"13\" height=\"13\" rx=\"2\"/><path d=\"M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3\"/></svg>Copy team link</button>",
      "css": ".ds-secondary{font-family:\"Manrope Variable\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:42px;padding:10px 15px;border:1px solid var(--line,#dfe3d9);border-radius:9px;background:var(--surface,#fffefa);color:var(--ink,#253d33);font-size:12px;font-weight:650;cursor:pointer;transition:background .16s,color .16s}.ds-secondary:hover{background:var(--sage,#e9eee3)}.ds-secondary:focus-visible{outline:3px solid var(--focus,#bb7536);outline-offset:4px}.ds-secondary:disabled{opacity:.48;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-secondary{transition-duration:.01ms}}"
    },
    {
      "name": "Text action",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Compact roster or history action.",
      "html": "<button class=\"ds-text\">Manage</button>",
      "css": ".ds-text{font-family:\"Manrope Variable\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:5px;padding:6px 0;background:transparent;border:0;color:var(--green,#2d5641);font-size:12px;font-weight:650;min-height:30px;white-space:nowrap;cursor:pointer}.ds-text:hover:not(:disabled){text-decoration:underline;text-underline-offset:3px}.ds-text:focus-visible{outline:3px solid var(--focus,#bb7536);outline-offset:4px}.ds-text:disabled{opacity:.48;cursor:not-allowed}"
    },
    {
      "name": "Icon action",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Named save, cancel, or dismiss control.",
      "html": "<button class=\"ds-icon\" aria-label=\"Cancel rename\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m18 6-12 12M6 6l12 12\"/></svg></button>",
      "css": ".ds-icon{display:inline-grid;place-items:center;width:30px;min-height:30px;padding:4px;border:0;border-radius:5px;background:transparent;color:var(--ink,#253d33);cursor:pointer}.ds-icon:hover{background:var(--sage,#e9eee3)}.ds-icon:focus-visible{outline:3px solid var(--focus,#bb7536);outline-offset:4px}.ds-icon:disabled{opacity:.48;cursor:not-allowed}"
    },
    {
      "name": "Add teammate field",
      "kind": "input",
      "refersTo": "input-add-person",
      "description": "Inline name field with a shared focus outline and plus action.",
      "html": "<form class=\"ds-add\"><label class=\"ds-sr\" for=\"ds-person\">Teammate’s name</label><input id=\"ds-person\" placeholder=\"Add a teammate’s name\" maxlength=\"60\" required/><button type=\"submit\" aria-label=\"Add teammate\"><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg></button></form>",
      "css": ".ds-add{font-family:\"Manrope Variable\",sans-serif;display:flex;align-items:center;max-width:380px;border:1px solid var(--line,#dfe3d9);background:#fafbf6;border-radius:8px;overflow:hidden}.ds-add:focus-within{outline:2px solid #698366;outline-offset:2px}.ds-add input{font-family:\"Manrope Variable\",sans-serif;min-width:0;flex:1;border:0;background:transparent;padding:12px;font-size:12px;color:var(--ink,#253d33);min-height:44px;caret-color:var(--green,#2d5641)}.ds-add input::placeholder{color:#6d7769}.ds-add input:focus-visible{outline:0}.ds-add button{display:grid;place-items:center;border:0;background:var(--sage,#e9eee3);color:var(--green,#2d5641);border-radius:6px;padding:6px;margin-right:5px;cursor:pointer}.ds-add button:hover:not(:disabled){background:#dce6cf}.ds-add button:focus-visible{outline:3px solid var(--focus,#bb7536);outline-offset:4px}.ds-add button:disabled{opacity:.48;cursor:not-allowed}.ds-sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}"
    },
    {
      "name": "Selection mode",
      "kind": "custom",
      "refersTo": "mode-segment",
      "description": "Native pressed buttons; the preview shows Balanced selected.",
      "html": "<div class=\"ds-modes\" role=\"group\" aria-label=\"Selection mode\"><button aria-pressed=\"false\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"m18 14 4 4-4 4M18 2l4 4-4 4M2 18h2c5 0 7-12 12-12h6M2 6h2c2 0 4 2 5 4m6 4c1 2 3 4 5 4h2\"/></svg>Random</button><button aria-pressed=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m20 0v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/></svg>Balanced</button></div>",
      "css": ".ds-modes{font-family:\"Manrope Variable\",sans-serif;display:inline-flex;padding:4px;gap:3px;background:#eaece3;border-radius:10px}.ds-modes button{font-family:\"Manrope Variable\",sans-serif;display:flex;align-items:center;justify-content:center;gap:8px;min-width:126px;min-height:38px;padding:8px 16px;border:0;border-radius:7px;background:transparent;color:#5d6b5b;font-weight:600;font-size:13px;cursor:pointer}.ds-modes button[aria-pressed=\"true\"]{background:var(--surface,#fffefa);color:var(--green,#2d5641);box-shadow:0 2px 5px #293d2510}.ds-modes button:hover:not([aria-pressed=\"true\"]):not(:disabled){background:#dce2d3}.ds-modes button:focus-visible{outline:3px solid var(--focus,#bb7536);outline-offset:4px}.ds-modes button:disabled{opacity:.48;cursor:not-allowed}"
    },
    {
      "name": "History mode tag",
      "kind": "chip",
      "refersTo": "mode-tag",
      "description": "Descriptive icon-and-text tags, never selection controls.",
      "html": "<span class=\"ds-tag\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"m18 14 4 4-4 4M18 2l4 4-4 4M2 18h2c5 0 7-12 12-12h6M2 6h2c2 0 4 2 5 4m6 4c1 2 3 4 5 4h2\"/></svg>Random</span> <span class=\"ds-tag ds-tag-balanced\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m20 0v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/></svg>Balanced</span>",
      "css": ".ds-tag{font-family:\"Manrope Variable\",sans-serif;display:inline-flex;align-items:center;gap:5px;padding:5px 8px;border-radius:5px;background:#ebece5;color:#51604f;font-size:10px}.ds-tag svg{width:12px;height:12px}.ds-tag-balanced{background:#e5ebe0;color:#405d3e}"
    },
    {
      "name": "Roster panel",
      "kind": "card",
      "refersTo": "team-panel",
      "description": "Quiet tonal container with aligned participant, picks, and odds.",
      "html": "<aside class=\"ds-panel\" aria-labelledby=\"ds-team\"><div class=\"ds-panel-heading\"><h2 id=\"ds-team\">Your team</h2><span class=\"ds-count\">1</span></div><p class=\"ds-subtitle\">Good company. Fair chances.</p><div class=\"ds-row\"><span class=\"ds-identity\"><span class=\"ds-avatar\" aria-hidden=\"true\">AD</span><strong>Alex (example)</strong></span><span class=\"ds-picks\">0</span><span class=\"ds-odds\">100%</span></div><div class=\"ds-panel-footer\"><span class=\"ds-dot\" aria-hidden=\"true\"></span>1 active · 0 picks saved</div></aside>",
      "css": ".ds-panel{font-family:\"Manrope Variable\",sans-serif;max-width:410px;min-width:0;background:var(--surface,#fffefa);color:var(--ink,#253d33);border:1px solid var(--line,#dfe3d9);border-radius:14px;padding:26px 24px 0}.ds-panel-heading{display:flex;align-items:center;gap:9px}.ds-panel h2{margin:0;font-size:19px;font-weight:650;letter-spacing:-.025em}.ds-count{display:grid;place-items:center;min-width:23px;min-height:23px;border-radius:6px;background:var(--sage,#e9eee3);font-size:11px;font-weight:650}.ds-subtitle{margin:8px 0 0;color:var(--muted,#667369);font-size:12px}.ds-row{display:grid;grid-template-columns:minmax(0,1fr) 42px 65px;gap:7px;align-items:center;min-height:70px;margin-top:25px;border-top:1px solid var(--line,#dfe3d9)}.ds-identity{display:flex;align-items:center;gap:10px;min-width:0}.ds-identity strong{font-size:13px;font-weight:650;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-avatar{display:grid;place-items:center;flex-shrink:0;width:34px;height:34px;border-radius:50%;background:#b9cec2;font-size:11px;font-weight:650}.ds-picks{display:grid;place-items:center;justify-self:center;min-width:29px;height:27px;border-radius:6px;background:#f0f2ea;font-size:12px;font-weight:650;font-variant-numeric:tabular-nums}.ds-odds{text-align:right;font-size:12px;font-weight:600;font-variant-numeric:tabular-nums}.ds-panel-footer{display:flex;align-items:center;gap:7px;margin:20px -24px 0;padding:15px 24px;background:#f8f9f3;border-top:1px solid var(--line,#dfe3d9);border-radius:0 0 14px 14px;color:var(--muted,#667369);font-size:10px}.ds-dot{width:5px;height:5px;border-radius:50%;background:#628563}"
    },
    {
      "name": "Brand home link",
      "kind": "nav",
      "refersTo": "brand-home",
      "description": "Compact wordmark with a circular direction mark and orange punctuation.",
      "html": "<a class=\"ds-brand\" href=\"/\" aria-label=\"Team Wheel home\"><span class=\"ds-brand-mark\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></span><span>teamwheel<span class=\"ds-period\">.</span></span></a>",
      "css": ".ds-brand{font-family:\"Manrope Variable\",sans-serif;display:inline-flex;align-items:center;gap:11px;color:var(--ink,#253d33);font-size:25px;font-weight:750;letter-spacing:-.035em;text-decoration:none}.ds-brand-mark{display:grid;place-items:center;width:37px;height:37px;border-radius:50%;background:var(--green,#2d5641);color:#fffdf5}.ds-brand-mark svg{width:25px;height:25px}.ds-period{color:var(--orange,#cd673d)}.ds-brand:focus-visible{outline:3px solid var(--focus,#bb7536);outline-offset:4px}"
    },
    {
      "name": "Wheel assembly",
      "kind": "custom",
      "refersTo": "wheel-assembly",
      "description": "Live probability geometry with a stationary pointer and hub; static example only.",
      "html": "<div class=\"ds-wheel\"><div class=\"ds-pointer\" aria-hidden=\"true\"><svg viewBox=\"0 0 30 38\"><path d=\"M3 4 Q15 -2 27 4 L18 32 Q15 38 12 32 Z\"/></svg></div><div class=\"ds-rotor\"><svg viewBox=\"0 0 520 520\" role=\"img\" aria-label=\"Example wheel with four equal chances; individual odds belong in the roster.\"><circle cx=\"260\" cy=\"260\" r=\"255\" fill=\"#f4f2ec\"/><path d=\"M260 260V16A244 244 0 0 1 504 260Z\" fill=\"#b9cec2\"/><path d=\"M260 260H504A244 244 0 0 1 260 504Z\" fill=\"#eac08c\"/><path d=\"M260 260V504A244 244 0 0 1 16 260Z\" fill=\"#b7c9e4\"/><path d=\"M260 260H16A244 244 0 0 1 260 16Z\" fill=\"#d9bad2\"/><path d=\"M260 16v488M16 260h488\" fill=\"none\" stroke=\"#f7f6f0\" stroke-width=\"2\"/><circle cx=\"260\" cy=\"260\" r=\"246\" fill=\"none\" stroke=\"#fffcf5\" stroke-width=\"5\"/></svg></div><span class=\"ds-hub\" aria-hidden=\"true\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></span></div>",
      "css": ".ds-wheel{position:relative;width:min(100%,400px);aspect-ratio:1;isolation:isolate}.ds-rotor{width:100%;height:100%;will-change:transform}.ds-rotor svg{display:block;width:100%;height:100%;filter:drop-shadow(0 7px 10px #2a402015)}.ds-pointer{position:absolute;z-index:3;top:-10px;left:calc(50% - 12.5px);width:25px;filter:drop-shadow(0 2px 2px #162c201f)}.ds-pointer path{fill:var(--ink,#253d33);stroke:#fdfbf5;stroke-width:1.5}.ds-hub{position:absolute;inset:calc(50% - 34px);display:grid;place-items:center;border-radius:50%;background:#fffdf6;color:var(--green,#2d5641);box-shadow:0 3px 12px #253d3320;pointer-events:none}.ds-hub svg{width:30px;height:30px}"
    }
  ],
  "narrative": {
    "northStar": "The Shared Table",
    "overview": "Team Wheel borrows the warmth of tabletop game pieces and a paper score sheet. A light paper ground, forest-green controls, and quiet pastel participants make a shared decision feel friendly and understandable. Rounded Manrope lettering gives headings and compact working labels one consistent voice.\n\nThe interface stays clear and familiar: real buttons, inline forms, a native disclosure, and a semantic history table. Character comes from the wheel, participant colors, small orange punctuation, and one deliberate motion: decelerating toward an already saved result. There is no photographic or illustrative asset layer; the wheel is live SVG geometry.",
    "keyCharacteristics": [
      "Warm paper surfaces with dark green type and controls.",
      "Pastel participant identity repeated across wheel, roster, and history.",
      "Compact, aligned working data beside a generous circular wheel.",
      "Native web controls, visible keyboard focus, and explicit state text.",
      "Saved-result deceleration with an instant reduced-motion alternative."
    ],
    "rules": [
      {
        "name": "The Same Person Rule",
        "body": "Derive participant color from the stable ID everywhere; a rename must not create a new visual identity.",
        "section": "colors"
      },
      {
        "name": "The Visible Odds Rule",
        "body": "Slice area and the numeric next odds describe the same probability; color is never a substitute for either.",
        "section": "colors"
      },
      {
        "name": "The One Voice Rule",
        "body": "Use Manrope for the interface, including SVG wheel labels; hierarchy comes from scale, weight, and spacing.",
        "section": "typography"
      },
      {
        "name": "The Tabletop Depth Rule",
        "body": "Reserve soft lift for the wheel pieces and selected mode; organize ordinary working surfaces with tone and borders.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the frontmatter palette and self-hosted Manrope roles for new controls.",
      "Do preserve participant ID colors across wheel, roster, and history.",
      "Do pair probability slices with numeric odds and explicit mode labels.",
      "Do keep native buttons, form submission, disclosure behavior, semantic tables, and visible keyboard focus.",
      "Do save the result before animating and complete immediately when reduced motion is requested.",
      "Do retain paused and undone entries with explicit text and readable historical context.",
      "Do allow long names to wrap in results and preserve table readability through local horizontal scrolling."
    ],
    "donts": [
      "Don't use participant color alone to communicate identity, selection, pause, or undo.",
      "Don't turn the orange punctuation accent into the primary action color.",
      "Don't add shadows to every panel; reserve the observed soft lift for wheel pieces and selected mode.",
      "Don't replace the working SVG wheel with a static image or let an animation choose the outcome.",
      "Don't treat local screenshot names, counts, dates, or colors as production seed data.",
      "Don't infer a custom account screen or a multi-page navigation system from the hosting access flow."
    ]
  }
}
